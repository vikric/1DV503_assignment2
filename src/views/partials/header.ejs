<header>
  <nav>
    <a class="nav-link" href="./">Home</a>

    <div class="login">
      <% if (user) { %>
      <form action="/login/logout" method="POST">
        <button type="submit"><%= user.name %></button>
      </form>
      <% } else { %>
      <a class="nav-link" href="./login">Login</a>
      <a class="nav-link" href="./register">Register</a>
      <% } %>
    </div>
  </nav>
</header>
