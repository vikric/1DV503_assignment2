<h1>Order Details</h1>

<div class="invoice-box">
  <h3>Invoice for Order no. <%= orderId %></h3>

  <h4>Shipping Address</h4>
  <p class="capitalize">
    <strong>Name:</strong> <%= member.fname %> <%= member.lname %><br />
    <strong>Address:</strong> <%= member.address %><br />
    <%= member.city %>, <%= member.zip %>
  </p>

  <h4>Books</h4>
  <div class="cart-table-wrapper">
    <table class="cart-table">
      <thead>
        <tr>
          <th>ISBN</th>
          <th>Title</th>
          <th>$</th>
          <th>Quantity</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <% cartItems.forEach(item => { %>
        <tr>
          <td><%= item.isbn %></td>
          <td><%= item.title %></td>
          <td>$<%= item.price %></td>
          <td><%= item.qty %></td>
          <td>$<%= item.amount %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <h3>Order Total: $<%= orderTotal %></h3>

  <p>
    <strong>Delivery date:</strong>
    <%= deliveryDate.toDateString() %>
  </p>
</div>
