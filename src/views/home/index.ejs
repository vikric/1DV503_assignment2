<div class="container">
  <% if (user) { %>

  <form class="search" method="GET" action="/books">
    <h2>Our Books</h2>
    <div class="dropdown">
      <input
        type="text"
        placeholder="Humour"
        id="dropdown-search"
        onkeyup="bookSearch()"
      />
      <div id="dropdown-list" class="dropdown-content">
        <!-- Dropdown results from server will be here -->
      </div>
      <button type="submit" name="filter" value="subject">
        Filter by Subject
      </button>
    </div>

    <input type="text" name="author" placeholder="Enter author name" value />
    <button type="submit" name="filter" value="author">Search by Author</button>

    <input type="text" name="title" placeholder="Enter book title" />
    <button type="submit" name="filter" value="title">Search by Title</button>

    <div class="items-per-page">
      <div><span>Items per page:</span></div>
      <button name="limit" value="2">2</button>
      <button name="limit" value="3">3</button>
      <button name="limit" value="5">5</button>
      <button name="limit" value="10">10</button>
      <button name="limit" value="20">20</button>
    </div>
  </form>

  <div class="book-list">
    <% if (viewData?.book) { %>
    <h2>Books</h2>
    <p>Page <%= viewData.currentPage %> of <%= viewData.totalPages %></p>
    <% } %> <% viewData?.books.forEach(book => { %>
    <form method="POST" action="/books">
      <div class="single-book">
        <p><strong>Title: </strong><%= book.title %></p>
        <p><strong>Author: </strong> <%= book.author %></p>
        <p><strong>ISBN: </strong> <%= book.isbn %></p>
        <p><strong>Price: </strong> <%= book.price %></p>
        <p><strong>Subject: </strong> <%= book.subject %></p>

        <input type="hidden" name="user" value="<%= user.name %>" />
        <input type="hidden" name="id" value="<%= user.id %>" />
        <input type="hidden" name="email" value="<%= user.email %>" />
        <input type="hidden" name="isbn" value="<%= book.isbn %>" />
        <input type="text" name="amount" value="1" />

        <button name="book_amount" value="amount">Add to Cart</button>
      </div>
    </form>
    <% }) %>
    <div class="pagination">
      <% if (viewData.currentPage > 1) { %>
      <form action="/books" method="GET" style="display: inline">
        <input type="hidden" name="author" value="<%= viewData.author %>" />
        <input type="hidden" name="title" value="<%= viewData.title %>" />
        <input type="hidden" name="subject" value="<%= viewData.subject %>" />
        <input type="hidden" name="limit" value="<%= viewData.limit %>" />
        <input
          type="hidden"
          name="page"
          value="<%= viewData.currentPage - 1 %>"
        />
        <button type="submit">Previous</button>
      </form>
      <% } %>

      <!-- <Pages> -->
      <% for (let i = 1; i <= viewData.totalPages; i++) { %>
      <form action="/books" method="GET">
        <input type="hidden" name="author" value="<%= viewData.author %>" />
        <input type="hidden" name="title" value="<%= viewData.title %>" />
        <input type="hidden" name="subject" value="<%= viewData.subject %>" />
        <input type="hidden" name="limit" value="<%= viewData.limit %>" />
        <input type="hidden" name="page" value="<%= i %>" />
        <button
          type="submit"
          class="<%= i === viewData.currentPage ? 'active' : '' %>"
        >
          <%= i %>
        </button>
      </form>
      <% } %> <% if (viewData.currentPage < viewData.totalPages) { %>
      <form action="/books" method="GET">
        <input type="hidden" name="author" value="<%= viewData.author %>" />
        <input type="hidden" name="title" value="<%= viewData.title %>" />
        <input type="hidden" name="subject" value="<%= viewData.subject %>" />
        <input type="hidden" name="limit" value="<%= viewData.limit %>" />
        <input
          type="hidden"
          name="page"
          value="<%= viewData.currentPage + 1 %>"
        />
        <button type="submit">Next</button>
      </form>
      <% } %>
    </div>
  </div>
</div>

<% } else { %>
<h1>1DV503!</h1>
<% } %>
